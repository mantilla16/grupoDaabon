{
  "name": "estructura-daabon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:server\" \"npm:client\"",
    "server": "node server/index.mjs",
    "client": "vite",
    "killports": "node scripts/killports.mjs",
    "predev": "node scripts/killports.mjs",
    "build": "tsc -b && vite build",
    "build:prod": "cross-env APP_BASE=/estructuradaabon/ vite build",
    "start": "cross-env NODE_ENV=production node server/index.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dagre": "^0.8.5",
    "express": "^5.2.1",
    "motion": "^13.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
